      scheme = sysconfig.get_default_scheme()
    else:
      scheme = sysconfig._get_default_scheme()
    if scheme == 'posix_local':
      if '$am_py_prefix' == '/usr':
        scheme = 'deb_system' # should only happen during Debian package builds
      else:
