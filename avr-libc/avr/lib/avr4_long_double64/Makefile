#   $@          --> eerd_byte_atmega48.o
#   basename    --> eerd_byte_atmega48
#   subst       --> eerd.byte.atmega48
#   basename    --> eerd.byte
#   subst       --> eerd_byte
#   addsuffix   --> eerd_byte.S
